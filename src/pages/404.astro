---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面不存在">
  <section class="container">
    <div class="hero" style="padding: 4rem 0 2rem; text-align: center;">
      <h1 class="hero__title" style="font-size: 4rem;">404</h1>
      <p class="hero__tagline">这页迷路了。</p>
      <div class="btn-row" style="justify-content: center; display: flex;">
        <a class="btn btn--primary" href="/">回首页</a>
        <a class="btn" href="/blog">看看博客</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero__title {
    background: linear-gradient(135deg, var(--color-accent), #8b5cf6);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
