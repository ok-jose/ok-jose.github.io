---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Avatar from '../components/Avatar.astro';
import StatusBar from '../components/StatusBar.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, CURRENT_STATUS, SOCIAL_LINKS } from '../consts';
import { workExperience, formatDateRange } from '../data/work';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = posts[0];
const recent = posts.slice(1, 4);
const currentRole = workExperience.find((w) => w.endDate === null);
---

<BaseLayout title={undefined} description={SITE_DESCRIPTION}>
  <section class="container">
    <div class="hero-card">
      <div class="hero-card__content">
        <h1 class="hero-card__greeting">
          Hi, 我是 <span class="hero-card__name">Jose</span>
          <span class="hero-card__wave" aria-hidden="true">👋</span>
        </h1>
        <p class="hero-card__bio">{SITE_DESCRIPTION}</p>

        <div class="hero-card__status">
          <StatusBar
            emoji={CURRENT_STATUS.emoji}
            label={CURRENT_STATUS.label}
            text={CURRENT_STATUS.text}
            href={CURRENT_STATUS.href}
          />
        </div>

        <div class="hero-card__socials">
          <SocialLinks links={SOCIAL_LINKS} />
        </div>
      </div>

      <div class="hero-card__avatar">
        <Avatar initials="J" size={180} />
      </div>
    </div>

    {
      currentRole && (
        <a class="current-role-card" href="/work">
          <div class="current-role-card__label">现在</div>
          <div class="current-role-card__content">
            <strong>{currentRole.role}</strong> @ {currentRole.company}
            <span class="current-role-card__since">
              自 {currentRole.startDate}
            </span>
          </div>
          <div class="current-role-card__arrow" aria-hidden="true">→</div>
        </a>
      )
    }

    <div class="home-grid">
      {
        recent.length > 0 && (
          <section class="home-block">
            <h2 class="section-title">最近博客</h2>
            <ul class="post-list">
              {recent.map((post) => (
                <li class="post-card">
                  <div class="post-card__main">
                    <h3 class="post-card__title">
                      <a href={`/blog/${post.id}`}>{post.data.title}</a>
                    </h3>
                    <div class="post-card__meta">
                      <FormattedDate date={post.data.pubDate} />
                      {post.data.tags.slice(0, 2).map((t) => (
                        <a class="tag" href={`/tags/${t}`}>
                          #{t}
                        </a>
                      ))}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            <a class="home-block__more" href="/blog">所有文章 →</a>
          </section>
        )
      }

      <section class="home-block">
        <h2 class="section-title">工作</h2>
        <ul class="mini-timeline">
          {workExperience.slice(0, 3).map((w) => (
            <li class="mini-timeline__item">
              <div class="mini-timeline__period">
                {formatDateRange(w.startDate, w.endDate)}
                {w.endDate === null && <span class="badge badge--current">至今</span>}
              </div>
              <div class="mini-timeline__title">
                <strong>{w.role}</strong>
                <span> @ {w.company}</span>
              </div>
            </li>
          ))}
        </ul>
        <a class="home-block__more" href="/work">查看完整经历 →</a>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .current-role-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0 0;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-fg);
    text-decoration: none;
    transition: all var(--transition);
  }
  .current-role-card:hover {
    border-color: var(--color-accent);
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  .current-role-card__label {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 0.3em 0.7em;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .current-role-card__content {
    flex: 1;
    font-size: 0.95rem;
  }
  .current-role-card__since {
    color: var(--color-fg-muted);
    font-size: 0.85rem;
    margin-left: 0.5rem;
  }
  .current-role-card__arrow {
    color: var(--color-fg-muted);
    font-size: 1.2rem;
    transition: transform var(--transition);
  }
  .current-role-card:hover .current-role-card__arrow {
    transform: translateX(3px);
    color: var(--color-accent);
  }

  .home-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  .home-block {
    min-width: 0;
  }

  .home-block__more {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-accent);
  }

  .mini-timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mini-timeline__item {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .mini-timeline__item:last-child { border-bottom: none; }

  .mini-timeline__period {
    color: var(--color-fg-muted);
    font-size: 0.8rem;
    margin-bottom: 0.2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .mini-timeline__title {
    font-size: 0.95rem;
    color: var(--color-fg);
  }
  .mini-timeline__title span {
    color: var(--color-fg-muted);
  }

  .badge {
    display: inline-block;
    padding: 0.1em 0.5em;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .badge--current {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .home-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
