---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Avatar from '../components/Avatar.astro';
import StatusBar from '../components/StatusBar.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, CURRENT_STATUS, SOCIAL_LINKS } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = posts[0];
const recent = posts.slice(1, 6);
---

<BaseLayout title={undefined} description={SITE_DESCRIPTION}>
  <section class="container">
    <div class="hero-card">
      <div class="hero-card__content">
        <h1 class="hero-card__greeting">
          Hi, 我是 <span class="hero-card__name">Jose</span>
          <span class="hero-card__wave" aria-hidden="true">👋</span>
        </h1>
        <p class="hero-card__bio">{SITE_DESCRIPTION}</p>

        <div class="hero-card__status">
          <StatusBar
            emoji={CURRENT_STATUS.emoji}
            label={CURRENT_STATUS.label}
            text={CURRENT_STATUS.text}
            href={CURRENT_STATUS.href}
          />
        </div>

        <div class="hero-card__socials">
          <SocialLinks links={SOCIAL_LINKS} />
        </div>
      </div>

      <div class="hero-card__avatar">
        <Avatar initials="J" size={180} />
      </div>
    </div>

    {
      featured && (
        <article class="featured-post">
          <div class="featured-post__badge">最新文章</div>
          <h2 class="featured-post__title">
            <a href={`/blog/${featured.id}/`}>{featured.data.title}</a>
          </h2>
          <div class="featured-post__meta">
            <time datetime={featured.data.pubDate.toISOString()}>
              <FormattedDate date={featured.data.pubDate} />
            </time>
            {featured.data.tags.slice(0, 3).map((t) => (
              <a class="tag" href={`/tags/${t}/`}>
                #{t}
              </a>
            ))}
          </div>
          {featured.data.description && (
            <p class="featured-post__desc">{featured.data.description}</p>
          )}
          <a class="featured-post__cta" href={`/blog/${featured.id}/`}>
            阅读全文 →
          </a>
        </article>
      )
    }

    {
      recent.length > 0 && (
        <>
          <h2 class="section-title">之前写的</h2>
          <ul class="post-list">
            {recent.map((post) => (
              <li class="post-card">
                <div class="post-card__main">
                  <h3 class="post-card__title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <div class="post-card__meta">
                    <FormattedDate date={post.data.pubDate} />
                    {post.data.tags.slice(0, 3).map((t) => (
                      <a class="tag" href={`/tags/${t}/`}>
                        #{t}
                      </a>
                    ))}
                  </div>
                  {post.data.description && (
                    <p class="post-card__desc">{post.data.description}</p>
                  )}
                </div>
                <div class="post-card__date-col">
                  <div class="year">{post.data.pubDate.getFullYear()}</div>
                </div>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</BaseLayout>

<style>
  .featured-post {
    position: relative;
    padding: 1.5rem 1.75rem;
    margin: 2rem 0;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
    overflow: hidden;
  }

  .featured-post::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), #8b5cf6);
  }

  .featured-post:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--color-accent);
  }

  .featured-post__badge {
    display: inline-block;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 0.2em 0.6em;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .featured-post__title {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .featured-post__title a {
    color: var(--color-fg);
  }

  .featured-post__title a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .featured-post__meta {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    align-items: center;
    color: var(--color-fg-muted);
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .featured-post__desc {
    margin: 0.5rem 0 1rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
  }

  .featured-post__cta {
    display: inline-block;
    color: var(--color-accent);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .featured-post__cta:hover {
    text-decoration: none;
    transform: translateX(3px);
    transition: transform var(--transition);
  }
</style>
