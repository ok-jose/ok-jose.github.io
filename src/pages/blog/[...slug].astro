---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime());
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: posts[i - 1] ?? null,
      next: posts[i + 1] ?? null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout entry={entry}>
  <Content />
</PostLayout>

<div class="prose-container post-nav-row">
  {
    prev ? (
      <a class="post-nav post-nav--prev" href={`/blog/${prev.id}/`}>
        <span class="post-nav__label">← 上一篇</span>
        <span class="post-nav__title">{prev.data.title}</span>
      </a>
    ) : (
      <div />
    )
  }
  {
    next ? (
      <a class="post-nav post-nav--next" href={`/blog/${next.id}/`}>
        <span class="post-nav__label">下一篇 →</span>
        <span class="post-nav__title">{next.data.title}</span>
      </a>
    ) : (
      <div />
    )
  }
</div>

<style>
  .post-nav-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }
  .post-nav {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-card);
    transition: all var(--transition);
    min-width: 0;
  }
  .post-nav:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
  }
  .post-nav--next {
    text-align: right;
    align-items: flex-end;
  }
  .post-nav__label {
    color: var(--color-fg-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-nav__title {
    color: var(--color-fg);
    font-weight: 500;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .post-nav:hover .post-nav__title { color: var(--color-accent); }
  @media (max-width: 540px) {
    .post-nav-row { grid-template-columns: 1fr; }
    .post-nav--next { text-align: left; align-items: flex-start; }
  }
</style>
