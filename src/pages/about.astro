---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
import { workExperience, formatDateRange } from '../data/work';

const lastRole = workExperience[0];
const totalYears = 9;
---

<BaseLayout title="关于" description={`关于 ${SITE_AUTHOR}`}>
  <section class="prose-container">
    <header style="text-align: center; padding: 3rem 0 2rem;">
      <div style="display: inline-block; position: relative;">
        <Avatar size={140} />
      </div>
      <h1 style="margin: 1.25rem 0 0.25rem; font-size: 1.8rem; letter-spacing: -0.02em;">
        {SITE_AUTHOR}
      </h1>
      <p style="color: var(--color-fg-muted); margin: 0; font-size: 0.95rem;">
        找工作中 · 高级前端工程师 · 9 年企业级前端经验
      </p>
    </header>

    <article class="prose">
      <p>
        你好，欢迎来到我的小角落。这个站从 2017 年的 <a href="https://github.com/ok-jose/ok-jose.github.io">hexo 博客</a> 演变而来，
        中间停了 9 年，2026 年用 Astro 重建。不只是博客，还放了<a href="/work">工作经历</a>和一些杂七杂八。
      </p>

      <h2>这里有什么</h2>
      <ul>
        <li><a href="/blog">博客</a> - 写代码、读书、折腾各种东西的记录</li>
        <li><a href="/work">工作经历</a> - 我做过的几份工作和一些项目</li>
        <li><a href="/tags">标签</a> - 按主题浏览博客文章</li>
      </ul>

      <h2>现在在做的事</h2>
      <p>
        2026 年 4 月从<strong>杭州端点网络科技有限公司</strong>离开，休整中，看新的机会。
        9 年企业级前端开发经验，深耕<strong>低代码平台</strong>、<strong>可视化系统</strong>、<strong>AI Agent 编排</strong>方向。
      </p>

      <h2>教育 & 证书</h2>
      <ul>
        <li><strong>河南大学</strong>（双一流）· 计算机科学与技术 · 本科 · 2013 — 2017</li>
        <li><strong>系统架构设计师</strong>（软考高级）</li>
      </ul>

      <h2>技术栈</h2>
      <ul>
        <li>静态站点：<a href="https://astro.build">Astro 5</a></li>
        <li>写作：Markdown / MDX（Content Collections）</li>
        <li>部署：GitHub Pages via GitHub Actions</li>
        <li>源文件：<a href="https://github.com/ok-jose/ok-jose.github.io">ok-jose/ok-jose.github.io</a></li>
      </ul>

      <h2>联系</h2>
      <SocialLinks links={SOCIAL_LINKS} />
    </article>
  </section>
</BaseLayout>
