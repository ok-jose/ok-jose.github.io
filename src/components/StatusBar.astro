---
interface Props {
  emoji?: string;
  label: string;
  text: string;
  href?: string;
}

const { emoji = '🔨', label, text, href } = Astro.props;
---

<div class="status-bar">
  <span class="status-bar__pulse" aria-hidden="true"></span>
  <span class="status-bar__emoji" aria-hidden="true">{emoji}</span>
  <span class="status-bar__text">
    <strong>{label}：</strong>
    {
      href ? (
        <a href={href}>{text}</a>
      ) : (
        <span>{text}</span>
      )
    }
  </span>
</div>

<style>
  .status-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--color-fg-muted);
    box-shadow: var(--shadow-sm);
  }

  .status-bar__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    position: relative;
    flex-shrink: 0;
  }

  .status-bar__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(2.5);
      opacity: 0;
    }
  }

  .status-bar__emoji {
    line-height: 1;
  }

  .status-bar__text strong {
    color: var(--color-fg);
    font-weight: 600;
    margin-right: 0.15rem;
  }

  .status-bar__text a {
    color: var(--color-accent);
  }
</style>
