---
interface Props {
  src?: string;
  alt?: string;
  size?: number;
  loading?: 'eager' | 'lazy';
}

const {
  src = '/avatar.jpg',
  alt = 'Jose 的头像',
  size = 180,
  loading = 'eager',
} = Astro.props;
---

<div class="avatar" style={`--avatar-size: ${size}px;`}>
  <img
    src={src}
    srcset={`${src} 800w, /avatar-200.jpg 200w`}
    sizes={`(max-width: 720px) ${Math.min(size, 140)}px, ${size}px`}
    alt={alt}
    width={size}
    height={size}
    loading={loading}
    decoding="async"
  />
</div>

<style>
  .avatar {
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 10px 30px -10px rgba(59, 130, 246, 0.5),
      0 0 0 1px var(--color-border),
      0 0 0 4px var(--color-bg);
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
    background: var(--color-bg-soft);
  }

  .avatar:hover {
    transform: scale(1.03) rotate(-2deg);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
  }
</style>
