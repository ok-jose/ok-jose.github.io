---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = entry.data;
const words = (entry.body ?? '').replace(/```[\s\S]*?```/g, '').length;
const readingTime = Math.max(1, Math.round(words / 350));
---

<BaseLayout title={title} description={description} showProgress={true}>
  <article class="prose-container">
    <header class="article-header">
      <h1>{title}</h1>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>
          <FormattedDate date={pubDate} />
        </time>
        <span>·</span>
        <span>约 {readingTime} 分钟</span>
        <span>·</span>
        <span>{words} 字</span>
        {
          updatedDate && (
            <>
              <span>·</span>
              <span>
                更新于 <FormattedDate date={updatedDate} />
              </span>
            </>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="article-tags">
            {tags.map((t) => (
              <a class="tag" href={`/tags/${t}/`}>
                #{t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <div class="prose-container">
    <a class="back-link" href="/blog">← 回到博客列表</a>
  </div>
</BaseLayout>
